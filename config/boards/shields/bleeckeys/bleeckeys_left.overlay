#include "bleeckeys.dtsi" // The shared dtsi file is included in the overlay
#include <dt-bindings/zmk/keys.h>

/ {
    // While CAPS MOD (layer 1) is active, a swipe taps Win + arrow in its direction.
    // A held Shift is added by the OS as usual (Win + Shift + arrow).
    // tick: swipe length needed per tap (pad is scaled to 1024).
    zip_capsmod_swipe: zip_capsmod_swipe {
        compatible = "zmk,input-processor-keybind";
        #input-processor-cells = <0>;
        bindings = <&kp LG(RIGHT)>, <&kp LG(LEFT)>, <&kp LG(UP)>, <&kp LG(DOWN)>;
        mode = <1>;
        tick = <350>;
        max_pending_activations = <1>;
    };
};

// Label of the kscan node in the dtsi
&kscan0 {
    col-gpios
        = <&pro_micro 19 GPIO_ACTIVE_HIGH>
        , <&pro_micro 18 GPIO_ACTIVE_HIGH>
        , <&pro_micro 15 GPIO_ACTIVE_HIGH>
        , <&pro_micro 14 GPIO_ACTIVE_HIGH>
        , <&pro_micro 16 GPIO_ACTIVE_HIGH>
        , <&pro_micro 10 GPIO_ACTIVE_HIGH>
        ;
};

&glidepoint_listener {
    status = "okay";

    capsmod_swipe {
        layers = <1>;
        input-processors = <&zip_absolute_to_relative &zip_capsmod_swipe>;
    };
};